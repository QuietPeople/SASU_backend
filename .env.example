# Docker 이미지 버전. Python 변경 시 pyproject.toml의 Ruff 대상 버전도 맞춘다.
PYTHON_VERSION=3.13
POSTGRES_VERSION=18

# 로컬 PC에 공개할 포트
BACKEND_PORT=8000
POSTGRES_PORT=5432

# 로컬 개발용 DB 설정. .env로 복사한 뒤 비밀번호를 정한다.
POSTGRES_DB=sasu
POSTGRES_USER=sasu
POSTGRES_PASSWORD=sasu_local_only

# 애플리케이션 공통 설정. Compose 내부 DB_HOST·DB_PORT는 db:5432로 전달한다.
DB_HOST=localhost
LOG_LEVEL=INFO
DB_ECHO=false
DB_CONNECT_TIMEOUT=5
VIDEO_STORAGE_ROOT=storage/videos
